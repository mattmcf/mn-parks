# Rails
RAILS_PORT=3451
FRONTEND_ORIGIN=http://127.0.0.1:4174

# Production (Render sets these; never commit real values)
# RAILS_ENV=production
# DATABASE_URL=postgres://USER:PASS@HOST:5432/mn_parks
# SECRET_KEY_BASE=generate-with-bin-rails-secret
# Optional: RAILS_MASTER_KEY=  (only if you decrypt config/credentials.yml.enc)

# Postgres
# Mac (Homebrew / Postgres.app): TCP localhost. Leave PGUSER unset so libpq
# uses your OS user (e.g. matt). Then: bin/rails db:prepare
PGHOST=localhost
# Linux/cloud Unix socket (do not use these on a Mac):
# PGHOST=/var/run/postgresql
# PGUSER=ubuntu

# Optional Google OAuth. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:3451/api/auth/google_oauth2/callback

# Optional. Used only by `bin/rake parks:refresh` (NPS Parks API).
# Leave blank to use the NPS DEMO_KEY (rate-limited). Not read at boot.
NPS_API_KEY=

# Optional. Used only by `bin/rake parks:refresh_reviews` (Recreation.gov RIDB).
# Leave blank to skip RIDB; MN DNR camping units + NPS campgrounds still run.
# Not read at boot.
RIDB_API_KEY=

# AI trip chat. Unset or `mock` uses the local deterministic planner (Hobby default).
# A paid vendor is not wired in this slice — do not set a key on Render Free.
AI_LLM_PROVIDER=mock
